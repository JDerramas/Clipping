# ==============================================================================
#  WHOPCLIPPER & OPENCHATCUT - TEMPLATE CONFIGURATION (.env.example)
# ==============================================================================
#  INSTRUCTIONS:
#  1. I-copy ang file na ito at i-rename sa ".env" sa mismong folder na ito:
#     copy .env.example .env
#  2. Ilagay ang iyong sariling API keys sa ibaba.
#  3. I-save! Kusang babasahin ito ng WhopClipper server nang hindi binabago ang code.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI VIRALITY, CAPTIONS & VIRAL MOMENT JUDGING
# ------------------------------------------------------------------------------
# Primary engine priority: "gemini" or "agentrouter"
PREFERRED_AI_ENGINE=agentrouter

# [AgentRouter.org API] - Models: gpt-5.6-sol (fast ~3s), gpt-6.1-sol, gpt-6-astra
# Get your key at: https://agentrouter.org
AGENTROUTER_API_KEY=your_agentrouter_api_key_here
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=gpt-6-astra

# [Google Gemini API] - Flash & Multimodal AI
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
LLM_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash

# [NVIDIA NIM API] - Llama 3.2 90B & Mistral Large
# Get your key at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
LLM_OPENAI_API_KEY=your_nvidia_api_key_here
LLM_OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_OPENAI_MODEL=meta/llama-3.2-90b-vision-instruct
LLM_OPENAI_API_MODE=chat

# [Claude / Anthropic Routing via AgentRouter]
ANTHROPIC_BASE_URL=https://agentrouter.org
ANTHROPIC_AUTH_TOKEN=your_agentrouter_api_key_here
CLAUDE_CODE_MODEL=claude-sonnet-5
LLM_PROVIDER=claude-code

# ------------------------------------------------------------------------------
# 2. VOICE, SOUND EFFECTS & TTS (ElevenLabs)
# ------------------------------------------------------------------------------
# Get your key at: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_SOUND_MODEL=eleven_text_to_sound_v2
PREFERRED_VOICE_VENDOR=elevenlabs

# ------------------------------------------------------------------------------
# 3. STOCK FOOTAGE, B-ROLL & IMAGES (Free media search)
# ------------------------------------------------------------------------------
# Pixabay API: https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# Pexels API: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Unsplash API: https://unsplash.com/developers
UNSPLASH_APP_ID=your_unsplash_app_id
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
UNSPLASH_SECRET_KEY=your_unsplash_secret_key

# ------------------------------------------------------------------------------
# 4. APP & STUDIO PREFERENCES
# ------------------------------------------------------------------------------
PORT=3000
UI_LOCALE=en
TARGET_AUDIENCE=US
